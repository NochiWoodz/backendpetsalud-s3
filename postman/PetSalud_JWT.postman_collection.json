{
  "info": {
    "name": "PetSalud JWT - Semana 3 (seguridad integrada)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Autenticación JWT (login, token Bearer) y autorización por rol. Ejecutar con Run collection sobre una BD recién creada (usuarios demo ids 1, 2 y 3)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "claveDemo",
      "value": "Petsalud2025"
    },
    {
      "key": "tokenGerente",
      "value": ""
    },
    {
      "key": "tokenEmpleado",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Login GERENTE (200, guarda token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"tokenGerente\", pm.response.json().token);",
              "pm.test(\"Respuesta con token Bearer\", function () { pm.expect(pm.response.json().tipo).to.eql(\"Bearer\"); pm.expect(pm.response.json().rol).to.eql(\"GERENTE\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"gerente@petsalud.cl\",\n  \"password\": \"{{claveDemo}}\"\n}"
        }
      }
    },
    {
      "name": "2 - Login EMPLEADO (200, guarda token)",
